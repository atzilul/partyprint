# Configure these as hosted secrets; never commit live values.
# Sending-only Resend key; enter the value in hosting secrets.
RESEND_API_KEY=
# Verified sender, e.g. PARTYPRINT <orders@partyprint.co.il>
MAIL_FROM=
# WhatsApp Business Cloud API: approved template with two body parameters.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Public tag IDs. GA loads unless the visitor opts out; Meta follows the region rule (docs/analytics.md).
GA_MEASUREMENT_ID=
META_PIXEL_ID=
# Optional: header the hosting edge is confirmed to overwrite with the visitor's country code.
PARTYPRINT_TRUSTED_COUNTRY_HEADER=
