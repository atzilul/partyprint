# Configure these as hosted secrets; never commit live values.
# Sending-only Resend key; enter the value in hosting secrets.
RESEND_API_KEY=
# Verified sender, e.g. PARTYPRINT <orders@partyprint.co.il>
MAIL_FROM=
# WhatsApp Business Cloud API: approved template with two body parameters.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Public tag IDs. PageView is sent before a choice; other events follow CONSENT_MODE (docs/analytics.md).
GA_MEASUREMENT_ID=
META_PIXEL_ID=
# Optional Meta pre-choice behavior events. Keep strict unless the owner/legal reviewer chooses notice.
CONSENT_MODE=strict
# Server-only Meta Conversions API access token. Keep in the hosting secrets manager, never client code.
META_CAPI_TOKEN=
# Optional temporary code for Events Manager → Test Events; remove after validation.
META_TEST_EVENT_CODE=
# Configure only when Hostinger overwrites this header with the visitor IP (reported: x-real-ip).
PARTYPRINT_TRUSTED_IP_HEADER=x-real-ip
# Optional: header the hosting edge is confirmed to overwrite with the visitor's country code.
PARTYPRINT_TRUSTED_COUNTRY_HEADER=
